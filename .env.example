# ── Supabase (Auth + Postgres). Both values are PUBLIC by design; data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Optional: comma-separated emails allowed to sign in / sign up. Empty = any Supabase user.
FOUNDER_EMAILS=

# ── AI providers (all optional; app works without them, AI features show "unavailable")
# Which provider to use: ollama | anthropic | openai-compatible. Empty = first configured.
AI_PROVIDER=
# Ollama (free, local). Must be reachable from the server running Next.js.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Claude (optional, paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Any OpenAI-compatible endpoint (e.g. a free-tier provider)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Cost accounting in USD cents per 1M tokens (0 = free/local)
AI_COST_INPUT_CENTS_PER_MTOK=0
AI_COST_OUTPUT_CENTS_PER_MTOK=0
# Hard timeout per AI call (ms) and max attempts per execution
AI_TIMEOUT_MS=60000
AI_MAX_ATTEMPTS=3
# If the main provider fails: free (default: other configured non-Anthropic providers), all (may use paid Anthropic), off
AI_FALLBACK=free

# ── Your own mailbox (no third-party service). Gmail: enable 2-Step Verification, then create an App Password.
MAIL_USER=you@gmail.com
MAIL_PASSWORD=
MAIL_FROM_NAME=AI Empire
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Required in commercial email to US recipients (CAN-SPAM): your postal address.
BUSINESS_ADDRESS=
OUTREACH_DAILY_LIMIT=20
REPORT_EMAIL=

# ── Scheduled jobs (Vercel Cron 09:00 & 19:00 IST reports, 14:00 IST autopilot backup; GitHub Actions autopilot
#    every 30 min uses the same CRON_SECRET). Both are server-only secrets.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
