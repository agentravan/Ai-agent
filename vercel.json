{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/morning",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/autopilot",
      "schedule": "30 8 * * *"
    }
  ]
}
